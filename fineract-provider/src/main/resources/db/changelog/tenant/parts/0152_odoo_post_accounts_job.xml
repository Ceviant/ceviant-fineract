<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="fineract" id="post_accounts_to_odoo_job-2">
        <insert tableName="job">
            <column name="name" value="Post Accounts To Odoo"/>
            <column name="display_name" value="Post Accounts To Odoo"/>
            <column name="cron_expression" value="0 3 * * *"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Post Accounts To OdooDetail1 _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="add_odoo_ref_id_to_gl_account" >
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="acc_gl_account" columnName="odoo_ref_id"/>
            </not>
        </preConditions>
        <addColumn tableName="acc_gl_account">
            <column name="odoo_ref_id" type="VARCHAR(200)">
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="post_journal_entries_to_odoo_job">
        <insert tableName="job">
            <column name="name" value="Post Transaction Journals To Odoo"/>
            <column name="display_name" value="Post Transaction Journals To Odoo"/>
            <column name="cron_expression" value="0 3 * * *"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Post Transaction Journals To OdooDetail1 _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="add_odoo_ref_id_to_acc_gl_journal_entry" >
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="acc_gl_journal_entry" columnName="odoo_ref_id"/>
            </not>
        </preConditions>
        <addColumn tableName="acc_gl_journal_entry">
            <column name="odoo_ref_id" type="VARCHAR(200)">
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
